<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="jfoundry" transaction-type="JTA">
        <jta-data-source>jfoundry</jta-data-source>
        <class>org.jfoundry.helidon.integration.TransactionVerificationRecord</class>
        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
        </properties>
    </persistence-unit>
</persistence>
