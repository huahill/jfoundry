<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         child.project.url.inherit.append.path="false"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.xfoundries</groupId>
    <artifactId>jfoundry-spring-boot-dependencies</artifactId>
    <version>1.4.0</version>
    <packaging>pom</packaging>
    <name>jfoundry-spring-boot-dependencies</name>
    <description>Spring Boot platform dependency management BOM for jfoundry applications.</description>
    <url>${jfoundry.release.url}</url>
    <licenses><license><name>Apache License, Version 2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0.txt</url><distribution>repo</distribution></license></licenses>
    <developers><developer><id>youngledo</id><name>youngledo</name></developer></developers>
    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
        <connection>${jfoundry.release.scm.connection}</connection>
        <developerConnection>${jfoundry.release.scm.developerConnection}</developerConnection>
        <url>${jfoundry.release.scm.url}</url>
        <tag>v1.4.0</tag>
    </scm>
    <properties>
        <project.build.outputTimestamp>2026-08-28T08:08:36Z</project.build.outputTimestamp>
        <jfoundry.release.url>https://github.com/xfoundries/jfoundry</jfoundry.release.url>
        <jfoundry.release.scm.connection>scm:git:https://github.com/xfoundries/jfoundry.git</jfoundry.release.scm.connection>
        <jfoundry.release.scm.developerConnection>scm:git:https://github.com/xfoundries/jfoundry.git</jfoundry.release.scm.developerConnection>
        <jfoundry.release.scm.url>https://github.com/xfoundries/jfoundry</jfoundry.release.scm.url>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>
        <spring-boot.version>4.1.1</spring-boot.version>
        <jmolecules-integrations.version>0.33.0</jmolecules-integrations.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <jobrunr.version>8.8.2</jobrunr.version>
        <redisson.version>4.7.0</redisson.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot manages versions only; applications select starters explicitly. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.jmolecules.integrations</groupId>
                <artifactId>jmolecules-spring</artifactId>
                <version>${jmolecules-integrations.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot-native-image</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jobrunr</groupId>
                <artifactId>jobrunr-spring-boot-4-starter</artifactId>
                <version>${jobrunr.version}</version>
            </dependency>
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <profiles>
        <profile>
            <id>release</id>
            <build><plugins>
                <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId><version>${maven-enforcer-plugin.version}</version><executions><execution><id>require-release-version</id><goals><goal>enforce</goal></goals><configuration><rules><requireReleaseVersion/></rules></configuration></execution></executions></plugin>
                <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-gpg-plugin</artifactId><version>${maven-gpg-plugin.version}</version><executions><execution><id>sign-artifacts</id><phase>verify</phase><goals><goal>sign</goal></goals></execution></executions></plugin>
                <plugin><groupId>org.sonatype.central</groupId><artifactId>central-publishing-maven-plugin</artifactId><version>${central-publishing-maven-plugin.version}</version><extensions>true</extensions><configuration><publishingServerId>jfoundry</publishingServerId><autoPublish>true</autoPublish><waitUntil>PUBLISHED</waitUntil></configuration></plugin>
            </plugins></build>
        </profile>
    </profiles>
</project>
