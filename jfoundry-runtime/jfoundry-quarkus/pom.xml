    <modelVersion>4.1.0</modelVersion>

    <parent>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>jfoundry-quarkus</artifactId>
    <packaging>pom</packaging>

    <name>jfoundry-quarkus</name>
