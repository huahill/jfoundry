        <subproject>deployment/jfoundry-messaging-kafka-quarkus-deployment</subproject>
        <subproject>deployment/jfoundry-messaging-rabbitmq-quarkus-deployment</subproject>
        <subproject>deployment/jfoundry-outbox-jpa-quarkus-deployment</subproject>
