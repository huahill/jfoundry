<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>jfoundry-helidon</artifactId>
    <packaging>pom</packaging>

    <name>jfoundry-helidon</name>
    <description>Helidon MP runtime integration for jfoundry framework-neutral contracts.</description>

    <properties>
        <!-- Required by the parent Hibernate 7.4.11.Final pin. Helidon 4.5.5 manages older releases. -->
        <helidon.hibernate.jakarta-persistence.version>3.2.0</helidon.hibernate.jakarta-persistence.version>
        <helidon.hibernate.jboss-logging.version>3.6.1.Final</helidon.hibernate.jboss-logging.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                jfoundry-parent directly manages Hibernate 7.4.11.Final, and a child BOM import cannot
                replace that direct entry. Helidon 4.5.5 would still downgrade this reactor to
                jakarta.persistence-api 3.1.0 and jboss-logging 3.5.3.Final. Hibernate 7.4.11.Final
                requires JPA 3.2.0, including PersistenceUnitTransactionType, and jboss-logging 3.6.1.Final.
                These build-local overrides are not part of the published Helidon BOM, which still
                follows Helidon's own Hibernate 6.3 line unless an application selects another version.
            -->
            <dependency>
                <groupId>jakarta.persistence</groupId>
                <artifactId>jakarta.persistence-api</artifactId>
                <version>${helidon.hibernate.jakarta-persistence.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jboss.logging</groupId>
                <artifactId>jboss-logging</artifactId>
                <version>${helidon.hibernate.jboss-logging.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.xfoundries</groupId>
                <artifactId>jfoundry-helidon-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                        <phase>process-classes</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <subprojects>
        <subproject>jfoundry-transaction-helidon</subproject>
        <subproject>jfoundry-domain-event-helidon</subproject>
        <subproject>jfoundry-domain-event-persistence-bridge-helidon</subproject>
        <subproject>jfoundry-domain-event-outbox-helidon</subproject>
        <subproject>jfoundry-persistence-helidon</subproject>
        <subproject>jfoundry-persistence-jpa-helidon</subproject>
        <subproject>jfoundry-web-helidon</subproject>
        <subproject>jfoundry-restclient-helidon</subproject>
        <subproject>jfoundry-outbox-helidon</subproject>
        <subproject>jfoundry-outbox-jpa-helidon</subproject>
        <subproject>jfoundry-inbox-jpa-helidon</subproject>
        <subproject>jfoundry-messaging-kafka-helidon</subproject>
        <subproject>jfoundry-messaging-rabbitmq-helidon</subproject>
        <subproject>jfoundry-lock-redisson-helidon</subproject>
        <subproject>jfoundry-helidon-integration-tests</subproject>
    </subprojects>
</project>
