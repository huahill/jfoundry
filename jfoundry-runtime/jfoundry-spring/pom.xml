        <subproject>autoconfigure/jfoundry-observability-spring-boot-autoconfigure</subproject>
        <subproject>autoconfigure/jfoundry-outbox-spring-boot-autoconfigure</subproject>
        <subproject>autoconfigure/jfoundry-inbox-spring-boot-autoconfigure</subproject>
        <subproject>autoconfigure/jfoundry-persistence-spring-boot-autoconfigure</subproject>
        <subproject>autoconfigure/jfoundry-persistence-mybatis-plus-spring-boot-autoconfigure</subproject>
        <subproject>autoconfigure/jfoundry-webmvc-spring-boot-autoconfigure</subproject>
