        <subproject>runtime/jfoundry-http-spring</subproject>
        <subproject>runtime/jfoundry-restclient-spring</subproject>
        <subproject>runtime/jfoundry-webmvc-spring</subproject>
        <subproject>autoconfigure/jfoundry-jpa-spring-boot-support</subproject>
        <subproject>autoconfigure/jfoundry-transaction-spring-boot-autoconfigure</subproject>
