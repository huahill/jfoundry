                        <configuration>
                            <mainClass>org.jfoundry.integration.nativeimage.mybatisplus.NativeMybatisPlusApplication</mainClass>
                        </configuration>
                        <executions>
                            <execution>
                                <id>process-aot-mybatis-plus</id>
                                <goals>
                                    <goal>process-aot</goal>
                                </goals>
                                <configuration>
